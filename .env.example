# ==============================================================================
# Supabase Configuration (Proof of Concept Foundation)
# ==============================================================================
# Copy this file to .env.local and fill in the values from your Supabase project dashboard.
# DO NOT commit .env.local or any real credentials to version control.

# Public Supabase URL (Used by client and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase Publishable / Anon Key (Safe to expose on the client, subject to RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER expose to browser)
# Used for administrative backend tasks bypassing RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Storage Bucket for Product Images
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=product-images
